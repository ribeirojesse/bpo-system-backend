# PASSO 2 (final) — HTTP redireciona pra HTTPS, API só responde em 443
# com certificado válido. Só use isso DEPOIS que o Certbot já tiver
# emitido o certificado (senão o nginx nem sobe, por falta do arquivo de
# certificado).
#
# Este arquivo é mantido só como referência/documentação do PASSO 2 — o
# config realmente ativo em produção é nginx/conf.d/app.conf, que já tem
# esse mesmo conteúdo. Pra reaplicar manualmente: copie este conteúdo por
# cima de nginx/conf.d/app.conf e rode
#   docker compose -f docker-compose.prod.yml exec nginx nginx -s reload
#
# O PASSO 1 (bootstrap, só HTTP, usado pra emitir o primeiro certificado
# num domínio novo) fica em nginx/templates/app.conf.bootstrap-http.

# A API fica atrás do Cloudflare: sem isto o nginx enxerga o IP do próprio
# Cloudflare (que muda a cada requisição) e o rate limit por IP nunca
# acumula. Confiamos no cabeçalho CF-Connecting-IP SOMENTE quando a conexão
# vem de um IP do Cloudflare (listas oficiais: cloudflare.com/ips-v4 e
# cloudflare.com/ips-v6 — revisar de tempos em tempos). Daqui em diante
# $remote_addr, o limit_req e o X-Real-IP repassado à API são o IP real
# do visitante.
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# Rate limiting global por IP (segunda camada: a API também limita por
# conta própria, ver app/core/rate_limit.py). Estas diretivas ficam no
# nível http porque conf.d/*.conf é incluído dentro do bloco http do nginx.
limit_req_zone $binary_remote_addr zone=api_geral:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=api_login:10m rate=10r/m;

server {
    listen 80;
    server_name api.towerbpo.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.towerbpo.com;

    ssl_certificate     /etc/letsencrypt/live/api.towerbpo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.towerbpo.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # A API só devolve JSON/arquivos: nada de scripts, frames ou recursos
    # externos jamais deveria ser carregado a partir dela.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    server_tokens off;

    client_max_body_size 20M;

    # Login e renovação de sessão: limite bem mais apertado (força bruta).
    location ~ ^/api/routes/auth/(login|refresh|mobile/login|mobile/refresh)$ {
        limit_req zone=api_login burst=5 nodelay;
        limit_req_status 429;

        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=api_geral burst=60 nodelay;
        limit_req_status 429;

        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
