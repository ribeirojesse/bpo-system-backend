# PASSO 2 (final) — HTTP redireciona pra HTTPS, API só responde em 443
# com certificado válido. Só use isso DEPOIS que o Certbot já tiver
# emitido o certificado (senão o nginx nem sobe, por falta do arquivo de
# certificado).
#
# Pra ativar: copie este conteúdo por cima de nginx/conf.d/app.conf e rode
#   docker compose -f docker-compose.prod.yml exec nginx nginx -s reload

server {
    listen 80;
    server_name api.towerbpo.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.towerbpo.com;

    ssl_certificate     /etc/letsencrypt/live/api.towerbpo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.towerbpo.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 20M;

    location / {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
