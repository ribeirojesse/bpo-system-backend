# Copie isso para ".env" dentro da pasta do backend na EC2 e preencha com
# valores reais. NUNCA commite o .env de verdade (o .dockerignore/.gitignore
# do projeto já ignoram .env, mantenha assim).

# Vem do output "database_url" do terraform (terraform output -raw database_url)
# formato: postgresql://usuario:senha@endereco-do-rds:5432/bpo_db
DATABASE_URL=postgresql://bpo_admin:SENHA_AQUI@SEU-RDS-ENDPOINT.rds.amazonaws.com:5432/bpo_db

# Gere um valor novo e forte, NUNCA reaproveite o do ambiente de dev:
#   openssl rand -hex 32
SECRET_KEY=GERE_UM_VALOR_NOVO_AQUI

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Liga o modo produção: desativa o --reload do uvicorn (ver docker-entrypoint.sh)
ENVIRONMENT=production

# Domínio(s) real(is) do frontend em produção, separados por vírgula.
# Sem isso, o navegador bloqueia as chamadas do frontend pra API (CORS).
ALLOWED_ORIGINS=https://towerbpo.com

# Domínio do cookie de sessão (access_token/refresh_token, ambos
# httpOnly). Com o ponto na frente: assim o cookie emitido por
# api.towerbpo.com também é enviado em chamadas vindas de towerbpo.com
# (mesmo domínio raiz = "mesmo site" pro navegador). Deixe em branco
# ("") só em dev local.
COOKIE_DOMAIN=.towerbpo.com

# IA (API do Claude / Anthropic) — OPCIONAL. Sem isso o sistema funciona
# normalmente, só sem as sugestões de conciliação com IA e sem a leitura
# de folha com IA (volta pra leitura simples de PDF). Gere a chave em
# console.anthropic.com e defina um limite mensal de gasto lá.
ANTHROPIC_API_KEY=
# Opcionais (padrões já definidos em app/core/config.py):
# AI_MODEL_CONCILIACAO=claude-haiku-4-5-20251001
# AI_MODEL_DOCUMENTOS=claude-sonnet-5
